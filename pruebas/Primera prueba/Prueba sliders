from numpy import array, zeros, arange
from numpy.linalg import norm
import matplotlib.pyplot as plt
from matplotlib.widgets import Slider
from methods import Euler, RK4, Crank_Nicolson

I1,I2,I3 = 1, 2, 3
Omega = 1; eps = 1e-3; Nv = 3
N = 10000 ; Dt = 0.01
U = zeros((N+1, Nv))
U[0, :] = array([eps, Omega, eps])

def F(U):
    w1, w2, w3 = U
    return array([(I2 - I3)/I1 * w2*w3,
                  (I3 - I1)/I2 * w3*w1,
                  (I1 - I2)/I3 * w1*w2])

def energia(U):
    return I1*U[:, 0]**2 + I2*U[:, 1]**2 + I3*U[:, 2]**2

t = arange(N+1) * Dt

# Fila superior: w(t). Fila inferior: deriva relativa de 2T
fig, axs = plt.subplots(2, 3, figsize=(15, 8), sharex=True)
plt.subplots_adjust(bottom=0.6)

ax_I1 = fig.add_axes([0.15, 0.2, 0.7, 0.03])
ax_I2 = fig.add_axes([0.15, 0.14, 0.7, 0.03])
ax_I3 = fig.add_axes([0.15, 0.08, 0.7, 0.03])
ax_Omega = fig.add_axes([0.15, 0.02, 0.7, 0.03])

slider_I1 = Slider(ax_I1, 'I1', 0.1, 5, valinit=I1)
slider_I2 = Slider(ax_I2, 'I2', 0.1, 5, valinit=I2)
slider_I3 = Slider(ax_I3, 'I3', 0.1, 5, valinit=I3)
slider_Omega = Slider(ax_Omega, 'Omega', 0, 5, valinit=Omega)

# Actualiza la solución
def actualizar(val):
    I1 = slider_I1.val
    I2 = slider_I2.val
    I3 = slider_I3.val
    Omega = slider_Omega.val
    U[0, :] = array([eps, Omega, eps])

    for j, metodo in enumerate((Euler, RK4, Crank_Nicolson)):

        Us = metodo(U.copy(), F, Dt, N)
        T2 = energia(Us)

        axs[0, j].clear()
        axs[1, j].clear()

        axs[0, j].plot(t, Us[:, 0], label=r'$w_1$')
        axs[0, j].plot(t, Us[:, 1], label=r'$w_2$')
        axs[0, j].plot(t, Us[:, 2], label=r'$w_3$')

        axs[0, j].set_title(metodo.__name__, fontweight='bold')
        axs[0, j].legend(loc='lower left')
        axs[0, j].grid(True, alpha=0.2)

        axs[1, j].semilogy(t, abs(T2 - T2[0]) / T2[0])
        axs[1, j].set_xlabel('t')
        axs[1, j].grid(True, alpha=0.2)

    axs[0, 0].set_ylabel('w', rotation=0)
    axs[1, 0].set_ylabel(
        r'$\frac{|T_2-T_{2_0}|}{T_{2_0}}$', rotation=0)

    fig.canvas.draw_idle()

slider_I1.on_changed(actualizar)
slider_I2.on_changed(actualizar)
slider_I3.on_changed(actualizar)
slider_Omega.on_changed(actualizar)
actualizar(None)
plt.show()