from numpy import array, arange, maximum, zeros
import matplotlib.pyplot as plt
from matplotlib.widgets import Button, Slider

from methods import Crank_Nicolson, Euler, RK4


I1_INICIAL, I2_INICIAL, I3_INICIAL = 1, 2, 3
OMEGA_INICIAL = 1
EPS = 1e-3
NV = 3
T_FINAL = 50
N = 1000
DT = T_FINAL / N


def F(U, inercias):
    I1, I2, I3 = inercias
    w1, w2, w3 = U
    return array([
        (I2 - I3) / I1 * w2 * w3,
        (I3 - I1) / I2 * w3 * w1,
        (I1 - I2) / I3 * w1 * w2,
    ])


def energia(U, inercias):
    I1, I2, I3 = inercias
    return I1 * U[:, 0]**2 + I2 * U[:, 1]**2 + I3 * U[:, 2]**2


t = arange(N + 1) * DT
metodos = (Euler, RK4, Crank_Nicolson)

fig, axs = plt.subplots(2, 3, figsize=(15, 8), sharex=True)
fig.suptitle(
    'Comparacion de metodos para las ecuaciones de Euler',
    fontweight='bold',
)
plt.subplots_adjust(
    left=0.07,
    right=0.98,
    top=0.88,
    bottom=0.32,
    hspace=0.32,
    wspace=0.22,
)

ax_I1 = fig.add_axes([0.15, 0.22, 0.7, 0.03])
ax_I2 = fig.add_axes([0.15, 0.17, 0.7, 0.03])
ax_I3 = fig.add_axes([0.15, 0.12, 0.7, 0.03])
ax_Omega = fig.add_axes([0.15, 0.07, 0.7, 0.03])
ax_reset = fig.add_axes([0.43, 0.015, 0.14, 0.035])

slider_I1 = Slider(ax_I1, 'I1', 0.1, 5, valinit=I1_INICIAL)
slider_I2 = Slider(ax_I2, 'I2', 0.1, 5, valinit=I2_INICIAL)
slider_I3 = Slider(ax_I3, 'I3', 0.1, 5, valinit=I3_INICIAL)
slider_Omega = Slider(ax_Omega, 'Omega', 0, 5, valinit=OMEGA_INICIAL)
boton_reset = Button(ax_reset, 'Reiniciar')


def actualizar(val):
    inercias = array([slider_I1.val, slider_I2.val, slider_I3.val])
    omega = slider_Omega.val

    U = zeros((N + 1, NV))
    U[0, :] = array([EPS, omega, EPS])

    for j, metodo in enumerate(metodos):
        def campo(estado):
            return F(estado, inercias)

        Us = metodo(U.copy(), campo, DT, N)
        E = energia(Us, inercias)
        deriva = abs(E - E[0]) / E[0]
        deriva = maximum(deriva, 1e-16)

        axs[0, j].clear()
        axs[1, j].clear()

        axs[0, j].plot(t, Us[:, 0], label=r'$\omega_1$')
        axs[0, j].plot(t, Us[:, 1], label=r'$\omega_2$')
        axs[0, j].plot(t, Us[:, 2], label=r'$\omega_3$')
        axs[0, j].set_title(metodo.__name__, fontweight='bold')
        axs[0, j].legend(loc='best', fontsize=8)
        axs[0, j].grid(True)

        axs[1, j].semilogy(t, deriva, color='tab:red')
        axs[1, j].set_xlabel('t')
        axs[1, j].grid(True)

    axs[0, 0].set_ylabel(r'$\omega$', rotation=0)
    axs[1, 0].set_ylabel(r'$\frac{|E-E_0|}{E_0}$', rotation=0)

    fig.canvas.draw_idle()


def reiniciar(event):
    slider_I1.reset()
    slider_I2.reset()
    slider_I3.reset()
    slider_Omega.reset()


slider_I1.on_changed(actualizar)
slider_I2.on_changed(actualizar)
slider_I3.on_changed(actualizar)
slider_Omega.on_changed(actualizar)
boton_reset.on_clicked(reiniciar)

actualizar(None)
plt.show()
